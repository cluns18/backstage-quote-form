# Copy to .env.local (git ignores it) and fill in. Every value here is a PUBLIC web
# config that is designed to ship in the browser bundle. No server secret ever goes here.

# Firebase web config for the house artwork bucket (artwork download links).
# Same values as the other OBG forms. Without them artwork still goes as an email
# attachment (about 2.5MB in all) and bigger files are refused with a message.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Shared OBG garment catalog (read-only publishable key). Powers "Explore all".
# Without it the form still runs on Backstage's own twelve styles (src/data/garments.json).
VITE_SUPABASE_URL=https://ydwzfnawueliuvywedla.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Analytics (optional, no-ops until set). GA4 measurement id + Microsoft Clarity id.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_ID=
